<script>
const cards=[...document.querySelectorAll('.expandable')];
cards.forEach(el=>{
  el.addEventListener('dblclick',e=>{e.preventDefault();el.classList.toggle('open')});
  el.addEventListener('click',e=>{
    if(e.target.closest('a,button')) return;
    if(window.matchMedia('(max-width:980px)').matches) el.classList.toggle('open');
  });
});
document.getElementById('notesBtn').onclick=()=>document.body.classList.toggle('show-notes');
document.addEventListener('keydown',e=>{
  if(e.key.toLowerCase()==='n') document.body.classList.toggle('show-notes');
});
let allOpen=false;
document.getElementById('expandBtn').onclick=()=>{
  allOpen=!allOpen; cards.forEach(c=>c.classList.toggle('open',allOpen));
  document.getElementById('expandBtn').textContent=allOpen?'cerrar todo':'expandir todo';
};
const sections=[...document.querySelectorAll('section')];
const links=[...document.querySelectorAll('nav a')];
const obs=new IntersectionObserver(entries=>{
  entries.forEach(en=>{
    if(en.isIntersecting){
      links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+en.target.id));
    }
  })
},{rootMargin:'-42% 0px -42% 0px',threshold:0});
sections.forEach(s=>obs.observe(s));
function updateProgress(){
  const d=document.documentElement;
  const pct=(d.scrollTop/(d.scrollHeight-d.clientHeight))*100;
  document.getElementById('progress').style.width=pct+'%';
}
document.addEventListener('scroll',updateProgress,{passive:true});
</script>
